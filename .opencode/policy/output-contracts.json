{
  "schema_version": 1,
  "description": "Workflow-owned output-contract registry. A profile may select one of these contracts but cannot introduce a new one. Mirrors scripts/agentic_prompts.py.",
  "contracts": {
    "pr-review-json-v1": {
      "kind": "json",
      "required_top_level_fields": ["summary"],
      "optional_top_level_fields": ["comments"],
      "max_summary_bytes": 16384,
      "max_comment_body_bytes": 8192,
      "max_suggestion_bytes": 16384,
      "max_path_bytes": 512,
      "max_comments": 50,
      "publication": "pull-request review with inline comments on allowed changed lines"
    },
    "issue-feedback-markdown-v1": {
      "kind": "markdown",
      "max_bytes": 16384,
      "forbidden": ["machine-readable fenced blocks", "hidden HTML comment markers"],
      "publication": "single issue comment"
    },
    "issue-implementation-decision-v1": {
      "kind": "text",
      "required_fields": ["IMPLEMENTATION_DECISION"],
      "conditional_fields": {
        "IMPLEMENTATION_BLOCKER": "required when IMPLEMENTATION_DECISION is BLOCKED"
      },
      "max_blocker_bytes": 4096,
      "publication": "issue status comment; PR creation only when decision is IMPLEMENT"
    },
    "release-project-issue-v1": {
      "kind": "json",
      "allowed_shapes": [
        {"decision": "NO_ISSUE", "required": ["summary"]},
        {
          "decision": "CREATE_ISSUE",
          "required": ["title", "body", "labels"]
        }
      ],
      "max_summary_bytes": 16384,
      "max_title_bytes": 512,
      "max_body_bytes": 32768,
      "allowed_labels": ["release-readiness"],
      "forbidden_fields": [
        "repository",
        "repo",
        "owner",
        "endpoint",
        "url",
        "assignee",
        "assignees",
        "milestone",
        "number",
        "issue_url",
        "labels_url",
        "token",
        "credentials"
      ],
      "forbidden_findings": ["code-only findings", "empty evidence"],
      "publication": "at most one release-readiness issue in the canonical target repository; workflow owns destination, marker, labels, and publication"
    },
    "release-project-analysis-handoff-v1": {
      "kind": "json",
      "required_top_level_fields": ["assessment", "validation_questions", "relevant_evidence"],
      "optional_top_level_fields": [],
      "max_assessment_bytes": 8192,
      "max_validation_questions": 20,
      "max_question_bytes": 1024,
      "max_relevant_evidence_items": 20,
      "max_evidence_bytes": 1024,
      "forbidden_fields": [
        "command",
        "commands",
        "args",
        "argv",
        "shell",
        "environment",
        "env",
        "working_directory",
        "cwd",
        "url",
        "repository",
        "repo",
        "endpoint",
        "credentials",
        "token",
        "decision",
        "title",
        "body",
        "labels"
      ],
      "publication": "non-publication intermediate contract; phase 1 of the two-stage release-project-review. The handoff is validated by the workflow, inserted into the phase-2 prompt as delimited untrusted data, and never published or appended to system instructions. The model cannot select a command, endpoint, repository, or credentials."
    }
  }
}
